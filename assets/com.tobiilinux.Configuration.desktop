[Desktop Entry]
Type=Application
Version=1.5
Name=Tobii Eye Tracker
GenericName=Eye Tracker Configuration
Comment=Set up and calibrate a Tobii Eye Tracker 5
Keywords=eye;tracker;tobii;gaze;calibration;head;tracking;
# No path here, because the PACKAGES install to /usr/bin, which is always on a
# launcher's PATH. A home install cannot rely on that — a launcher does not read
# your shell profile — so scripts/install-payload.sh rewrites this line to an
# absolute path when it installs the entry under ~/.local/share.
Exec=tobii-gtk
Icon=com.tobiilinux.Configuration
Terminal=false
# Must match APP_ID in crates/tobii-gtk/src/lib.rs, or the shell cannot match
# the window to this entry — the taskbar then shows a generic icon and the
# "pin to dock" it offers points at nothing.
StartupWMClass=com.tobiilinux.Configuration
StartupNotify=true
Categories=Settings;HardwareSettings;
